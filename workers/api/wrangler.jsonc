{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "attendance-manager",
  "main": "src/index.ts",
  "account_id": "e8175a8e88ef599f43bf8a4f07d0874d",
  "compatibility_date": "2026-07-01",
  "routes": [{ "pattern": "attendance-manager.example.com", "custom_domain": true }],
  // workers.devのURLはCloudflare Accessで保護されないため必ず無効化する
  "workers_dev": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "876253fd9d5b82d3862f7b3d80d5a475b71d35934c7aacdb76cc264724562e41",
    // 管理者機能(/admin)を使えるメールアドレス(カンマ区切り)
    "ADMIN_EMAILS": "owner@example.com"
  },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attendance-manager-db",
      "database_id": "a78a4869-7adf-456c-9052-fa8cedc5e45b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
