{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "attendance-manager-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attendance-manager-db",
      // `wrangler d1 create attendance-manager-db` 実行後に発行されるIDに置き換える。
      // ローカル開発(`wrangler dev`のデフォルト)ではこの値は使われず、.wrangler/state配下の
      // ローカルSQLiteが使われるため、リモートD1作成前でも動作確認できる。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
