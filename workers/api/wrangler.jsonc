{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "attendance-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // fetch()を常に公開インターネット経由にする。OAuthのCIMD(クライアントが指定したURLの文書)を取りに行くとき、
  // 同じゾーンや非公開の宛先へ抜けるSSRFを防ぐため(docs/adr/0004)
  "compatibility_flags": ["global_fetch_strictly_public"],
  "routes": [{ "pattern": "attendance-manager.example.com", "custom_domain": true }],
  // workers.devとPreview URLはCloudflare Accessで保護されないため必ず無効化する
  "workers_dev": false,
  "preview_urls": false,
  // routesのpatternとACCESS_TEAM_DOMAINはプレースホルダー。本番の値はGitHub Actions(ci.yml)が
  // デプロイ直前にGitHub Secretsから差し込む。そのためローカルから直接 wrangler deploy しないこと。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "876253fd9d5b82d3862f7b3d80d5a475b71d35934c7aacdb76cc264724562e41"
    // 管理者機能(/admin)を使えるメールアドレス(カンマ区切り)ADMIN_EMAILSは個人情報のため
    // varsに書かず、本番は `wrangler secret put ADMIN_EMAILS`、ローカルは .dev.vars で設定する
  },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attendance-manager-db",
      "database_id": "a78a4869-7adf-456c-9052-fa8cedc5e45b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
